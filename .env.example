# Optional canonical origin for a custom production domain. Vercel's production URL is used when blank.
NEXT_PUBLIC_SITE_URL=

# Contact form email delivery (server-side only).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Use a sender address on a domain verified in Resend, e.g. Portfolio <contact@example.com>.
CONTACT_FROM_EMAIL=

# Shared rate limiting for Vercel/serverless deployments.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
